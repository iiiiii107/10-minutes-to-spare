# Paste the whole firebaseConfig object from the Firebase console here, as JSON,
# on ONE line. Settings → General → Your apps → SDK setup and configuration.
#
# These values are not secrets — every Firebase web app ships them to the
# browser. What keeps your tasks private is the security rules in
# firestore.rules, which only let an account touch its own data.
#
# Copy this file to .env.local and fill it in. Leave it out and the app simply
# runs without sync, saving to the browser as before.

VITE_FIREBASE_CONFIG={"apiKey":"…","authDomain":"…firebaseapp.com","projectId":"…","storageBucket":"….firebasestorage.app","messagingSenderId":"…","appId":"…"}

# Google Calendar. The OAuth client id from Google Cloud Console →
# APIs & Services → Credentials. Firebase already made one for the web app;
# it needs your site added to its Authorized JavaScript origins, and the
# Google Calendar API turned on for the project. Leave it out and the app runs
# without the calendar, exactly as before.

VITE_GOOGLE_CLIENT_ID=…apps.googleusercontent.com
